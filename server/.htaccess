# 親ディレクトリの .htaccess にある書き換えルール（mod_rewrite）を、このサイトには適用しない。
# 適用されると内部リダイレクトが無限ループし、app.js や PHP が 500 エラーになる
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

DirectoryIndex index.html

# 設定・共通処理・スキーマは直接配信しない
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|schema\.sql)$">
  Require all denied
</FilesMatch>

# index.html は毎回サーバーに確認させる（app.js・style.css はURLにコミットIDが付くので、更新時は必ず新しい版が読まれる）
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
